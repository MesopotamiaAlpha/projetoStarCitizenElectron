{
  "name": "companheiro-emoto",
  "version": "2.4.3",
  "description": "Companheiro Emoto 2.0.0 — Star Citizen Companion App",
  "author": "Companheiro Emoto",
  "main": "electron/main.js",
  "scripts": {
    "react-start": "cross-env BROWSER=none CI=true react-scripts start",
    "dev": "concurrently \"cross-env BROWSER=none CI=true react-scripts start\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "react-build": "react-scripts build",
    "build": "npm run build:win",
    "clean:dist": "node scripts/clean-dist.cjs",
    "build:win": "npm run clean:dist && npm run react-build && electron-builder --win",
    "electron": "electron .",
    "check:electron": "node --check electron/main.js && node --check electron/preload.js && node --check electron/missionWatcher.js",
    "test": "react-scripts test --watchAll=false --passWithNoTests",
    "verify": "npm run test && npm run react-build && npm run check:electron"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^0.383.0",
    "pixi.js": "^8.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "react-scripts": "5.0.1",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "build": {
    "extends": null,
    "appId": "com.companheiroemoto.app",
    "productName": "Companheiro Emoto",
    "artifactName": "Companheiro-Emoto-${version}.${ext}",
    "asar": true,
    "files": [
      "build/**/*",
      "electron/**/*",
      "!**/CompanheiroEmoto{,/**/*}",
      "!**/CompanheiroEmoto-Dev{,/**/*}",
      "!**/dados{,/**/*}",
      "!**/backup{,/**/*}",
      "!**/*.db",
      "!**/*.sqlite",
      "!**/*.sqlite3",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "electron-icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "homepage": "./"
}
